{
	"name": "sveltekit-start",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"email": "email dev --dir src/lib/server/email/templates",
		"db:gen": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:reset": "bun run db/reset.ts",
		"db:rebuild": "bun run db:reset && bun run db:gen && bun run db:migrate",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@playwright/test": "^1.52.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/bun": "^1.2.10",
		"@types/eslint": "^9.6.1",
		"@types/react": "^19.1.2",
		"eslint": "^9.25.1",
		"eslint-config-prettier": "^10.1.2",
		"eslint-plugin-svelte": "^3.5.1",
		"globals": "^16.0.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"react-email": "^4.0.7",
		"svelte-check": "^4.1.6",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.31.0",
		"vitest": "^3.1.2"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.5",
		"@sveltejs/kit": "^2.20.7",
		"@tailwindcss/typography": "^0.5.16",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"svelte": "^5.28.2",
		"drizzle-kit": "^0.31.0",
		"sveltekit-superforms": "^2.24.1",
		"vite": "^6.3.2",
		"tailwindcss": "^4.1.4",
		"@node-rs/argon2": "^2.0.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@react-email/components": "^0.0.36",
		"@simplewebauthn/browser": "^13.1.0",
		"@simplewebauthn/server": "^13.1.1",
		"@sveltejs/adapter-vercel": "^5.7.0",
		"@tailwindcss/postcss": "^4.1.4",
		"@tailwindcss/vite": "^4.1.4",
		"better-sqlite3": "^11.9.1",
		"clsx": "^2.1.1",
		"dotenv": "^16.5.0",
		"drizzle-orm": "^0.42.0",
		"drizzle-zod": "^0.7.1",
		"hono": "^4.7.7",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"resend": "^4.4.0",
		"sveltekit-meta": "^0.2.0",
		"tailwind-merge": "^3.2.0",
		"zod": "^3.24.3"
	}
}
