{
	"name": "sveltekit-start",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"dev-host": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"email": "email dev --dir src/lib/server/email/templates",
		"db:gen": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:reset": "bun run db/reset.ts",
		"db:rebuild": "bun run db:reset && bun run db:gen && bun run db:migrate",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@playwright/test": "^1.53.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/bun": "^1.2.16",
		"@types/eslint": "^9.6.1",
		"@types/react": "^19.1.8",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.9.2",
		"globals": "^16.2.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.12",
		"react-email": "^4.0.16",
		"svelte-check": "^4.2.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.34.1",
		"vitest": "^3.2.4"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.6",
		"@fontsource/libre-baskerville": "^5.2.6",
		"@internationalized/date": "^3.8.2",
		"@node-rs/argon2": "^2.0.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@react-email/components": "^0.0.36",
		"@simplewebauthn/browser": "^13.1.0",
		"@simplewebauthn/server": "^13.1.1",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/adapter-vercel": "^5.7.2",
		"@sveltejs/kit": "^2.21.5",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tabler/icons-svelte": "^3.34.0",
		"@tailwindcss/postcss": "^4.1.10",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.10",
		"better-sqlite3": "^11.10.0",
		"bits-ui": "^2.8.2",
		"clsx": "^2.1.1",
		"dotenv": "^16.5.0",
		"drizzle-kit": "^0.31.1",
		"drizzle-orm": "^0.42.0",
		"drizzle-zod": "^0.7.1",
		"gsap": "^3.13.0",
		"hono": "^4.8.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"resend": "^4.6.0",
		"svelte": "^5.34.6",
		"sveltekit-meta": "^0.2.0",
		"sveltekit-superforms": "^2.27.0",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.10",
		"vite": "^6.3.5",
		"zod": "^3.25.67"
	}
}
